# Postgres de producción. Si se omite, se usa PGlite (Postgres embebido) en BID_DATA_DIR/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/bid

# Carpeta de datos locales (PGlite + ficheros subidos). Fuera de iCloud/Documents va mucho más rápido.
BID_DATA_DIR=.data

# Modo demo: siembra datos de ejemplo si la BD está vacía, selector de rol en la cabecera,
# acceso rápido como admin y "Restablecer datos de demo". Desactivar en producción.
BID_DEMO=1

# URL pública (enlaces de los emails). Si se omite, se usa el host de la petición.
# APP_URL=https://bid.example.com

# — Emails (Resend) —
# Sin RESEND_API_KEY los emails se escriben en la consola del servidor.
# RESEND_API_KEY=re_xxxxxxxx
# Remitente. Sin dominio verificado en Resend usa onboarding@resend.dev (solo entrega a tu propio email).
# EMAIL_FROM=Bidra Pro <avisos@bidrapro.com>
# Mientras haya datos de demo, desvía TODOS los emails a tu buzón (sus empresas tienen emails inventados).
# EMAIL_REDIRECT_TO=tu@email.es
# EMAIL_REPLY_TO=hola@tudominio.es

# — Producción —
# Primer administrador: al arrancar (comprobación /api/health) se crea la cuenta y se le envía un
# enlace para elegir contraseña. Basta con dejarla puesta; no hace nada si la cuenta ya existe.
# ADMIN_EMAIL=admin@tudominio.es
# Clave de /api/cron (cierre de pujas y avisos a tiempo, plazos de tanteo). Ver .github/workflows/cron.yml
# CRON_SECRET=una-cadena-larga-aleatoria
# Contraseña compartida para toda la web (solo demo/pruebas privadas). No usar en producción real.
# SITE_PASSWORD=
